{
  "name": "zxxr-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5274",
    "dev:store": "vite --mode store --host 127.0.0.1 --port 5275",
    "dev:prelaunch": "vite --mode prelaunch --host 127.0.0.1 --port 5276",
    "dev:launch": "vite --config vite.launch-preview.config.ts",
    "check:launch": "tsc --noEmit -p tsconfig.launch-preview.json",
    "build:launch": "npm run check:launch && vite build --config vite.launch-preview.config.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/prerender-seo.mjs",
    "build:store": "npm run check && vite build --mode store && node scripts/prerender-seo.mjs",
    "prepare:prelaunch": "node scripts/prepare-prelaunch-assets.mjs",
    "prepare:store": "node scripts/prepare-store-assets.mjs",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "deploy:free:preview": "npm run build && wrangler pages deploy dist --project-name=zxxr-store --branch=pre-venda-whatsapp",
    "prepare:images": "node scripts/prepare-assets.cjs && node scripts/optimize-photos.cjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.9.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.153.0"
  }
}
